# BibMedEd Environment Configuration
# Copy to .env and customize as needed.
# All values below are defaults — the app works out of the box without a .env file.

# Optional: NCBI API key (free registration at https://www.ncbi.nlm.nih.gov/account/).
# With a key, PubMed requests run at 10 req/s; without one, at 3 req/s.
BIBMEDED_PUBMED_API_KEY=

# Optional: PubMed request rate in requests/second. Leave empty to use the rate above.
# A value here always wins, with or without a key, and is not capped.
BIBMEDED_PUBMED_RATE_LIMIT=

# Optional: contact email sent as mailto= to OpenAlex and CrossRef (their "polite pool")
BIBMEDED_OPENALEX_EMAIL=
BIBMEDED_CROSSREF_EMAIL=

# Optional: Semantic Scholar API key for the keyed tier (1 req/s sustained)
BIBMEDED_SEMANTIC_SCHOLAR_API_KEY=

# Required only when using Lens.org: Scholarly API bearer token
BIBMEDED_LENS_API_KEY=

# Public read-only demo mode: blocks every write and outbound search.
# See docs/deploy.md before exposing an instance publicly.
BIBMEDED_READ_ONLY=false

# PostgreSQL credentials (defaults work with docker-compose)
POSTGRES_USER=bibmeded
POSTGRES_PASSWORD=bibmeded
POSTGRES_DB=bibmeded
